{
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "${{BACKEND_URL}}/api/$1"
    },
    {
      "src": "/auth/(.*)",
      "dest": "${{BACKEND_URL}}/auth/$1"
    },
    {
      "src": "/dashboard/(.*)",
      "dest": "${{BACKEND_URL}}/dashboard/$1"
    },
    { "handle": "filesystem" },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ]
}
