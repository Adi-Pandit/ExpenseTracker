# ── Terraform ──────────────────────────────────────────────────────────────────
# terraform.tfvars contains real secrets — never commit
infra/terraform.tfvars
# .terraform/ is the local provider cache, auto-generated on terraform init
infra/.terraform/
# state files track deployed resources — use S3 backend for teams
infra/terraform.tfstate
infra/terraform.tfstate.backup
infra/tfplan

